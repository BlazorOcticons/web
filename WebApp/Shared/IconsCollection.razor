@using WebApp.Shared;
@using System.Reflection;

@code{

  public delegate Task PopupClickEventHandler(string arg);

  [Parameter]
  public PopupClickEventHandler OnClick { get; set; }

  private string _searchText = "";

  private Type GetIconType(string iconName)
  {
    return Type.GetType($"BlazorOcticons.Octicons.{iconName}, BlazorOcticons");
  }

  private static Dictionary<int, string[]> _iconsBySize;

  private static Dictionary<int, string[]> GetIconsBySize()
  {
    if (_iconsBySize != null)
      return _iconsBySize;

    var assembly = Assembly.Load("BlazorOcticons");
    var iconTypes = assembly.GetTypes()
        .Where(t => t.Namespace == "BlazorOcticons.Octicons" && t.IsClass)
        .Select(t => t.Name)
        .ToList();

    _iconsBySize = new Dictionary<int, string[]>();

    // Group icons by their size suffix (e.g., "Alert16" -> 16)
    foreach (var iconName in iconTypes)
    {
      // Extract size from icon name (last digits)
      var sizeStr = new string(iconName.Reverse().TakeWhile(char.IsDigit).Reverse().ToArray());
      if (int.TryParse(sizeStr, out var size))
      {
        if (!_iconsBySize.ContainsKey(size))
          _iconsBySize[size] = [];
        _iconsBySize[size] = _iconsBySize[size].Append(iconName).ToArray();
      }
    }

    return _iconsBySize;
  }

  private IEnumerable<string> FilterIcons(string[] icons)
  {
    if (string.IsNullOrWhiteSpace(_searchText))
      return icons.OrderBy(x => x);

    return icons
        .Where(x => x.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x);
  }
}

<div class="pb-4">
  <input type="text"
         class="w-12 py-3 px-4 br-3 fs-large search-input"
         placeholder="Search icons..."
         @bind="_searchText"
         @bind:event="oninput" />
</div>

@foreach (var (size, icons) in GetIconsBySize().OrderBy(x => x.Key))
{
  var filteredIcons = FilterIcons(icons).ToList();
  if (filteredIcons.Count > 0)
  {
    <div class="py-4">
      <div class="pb-3">
        <span class="fw-bold fs-x-large">@(size)px</span>
        <span class="text-muted">(@filteredIcons.Count)</span>
      </div>
      <div class="d-flex pb-3 flex-wrap-wrap">
        @foreach (var iconName in filteredIcons)
        {
          <div class="p-3">
            <a class="cursor-pointer" @onclick="@(async () => await OnClick.Invoke(iconName))">
              <DynamicComponent Type="GetIconType(iconName)" />
            </a>
          </div>
        }
      </div>
    </div>
  }
}

<DynamicComponent Type="@IconCatalog.Types[_iconName]" Parameters="@_params"/>

@code {
  private readonly string _iconName = IconCatalog.Names[Random.Shared.Next(IconCatalog.Names.Length)];
  private readonly Dictionary<string, object> _params = new() { { "Color", "#d7e8f7" }, { "Size", Random.Shared.Next(20, 40) } };
}
